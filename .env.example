# Daemon secrets. Copy to .env next to config.yaml and chmod 600 .env  (this file is never copied by deploy.sh or sent anywhere).
#
# Use a value in config.yaml as   api_key: ${DAEMON_LLM_API_KEY}
# or just leave the field empty there: key / token / secret / password fields, phone numbers and account ids are filled from DAEMON_<SECTION>_<FIELD>.
DAEMON_LLM_API_KEY=
DAEMON_SEARCH_BRAVE_KEY=
DAEMON_ELEVENLABS_API_KEY=
DAEMON_STT_CLOUD_API_KEY=
DAEMON_SPOTIFY_CLIENT_ID=
DAEMON_SPOTIFY_CLIENT_SECRET=
DAEMON_NOTIFY_TWILIO_SID=
DAEMON_NOTIFY_TWILIO_TOKEN=
DAEMON_NOTIFY_TWILIO_FROM=
DAEMON_NOTIFY_TWILIO_TO=
DAEMON_SIGNAL_ACCOUNT=
DAEMON_SIGNAL_ALLOWED=
DAEMON_SATELLITE_TOKEN=
